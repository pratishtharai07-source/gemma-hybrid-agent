# ---------------------------------------------------------------------------
# Cloud tier: Gemma 4 through the Gemini API
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# Only these two Gemma 4 model IDs exist on the Gemini API.
# E2B / E4B are local-only (GGUF) and will 404 here.
GEMMA_CLOUD_MODEL=gemma-4-26b-a4b-it
GEMMA_CLOUD_MODEL_STRONG=gemma-4-31b-it

# ---------------------------------------------------------------------------
# Local tier: Gemma 4 E2B on-device
# Either llama.cpp server (default port 8080) or Ollama (default port 11434).
# Set LOCAL_LLM_MODE=auto to auto-detect.
# ---------------------------------------------------------------------------
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODE=auto
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=gemma4-e2b
LOCAL_LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Router behaviour
# ---------------------------------------------------------------------------
# 0.0-1.0: below this confidence the local triage result is trusted.
ESCALATE_THRESHOLD=0.55
MAX_TOOL_ITERATIONS=5
MAX_OUTPUT_TOKENS=2048

# Ask the model to think at a lower depth (saves ~20% thinking tokens
# per the official Gemma 4 prompt-formatting guide).
LOW_THINKING_INSTRUCTION=true
